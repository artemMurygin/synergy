# --- App ---
NODE_ENV=development
PORT=3000
# Внешний порт при запуске через docker compose
APP_PORT=3000
LOG_LEVEL=info

# --- PostgreSQL: основная БД (Slonik) ---
POSTGRES_URL=postgresql://audit:audit@localhost:5432/audit_agent

# --- MSSQL: внешняя БД (Prisma) ---
MSSQL_URL=sqlserver://localhost:1433;database=master;user=sa;password=Audit_Agent1;trustServerCertificate=true

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- LLM ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# Необязательно: прокси-совместимый endpoint (например, omniroute), напр. http://localhost:20128/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1

# Прототип sheets-qa: модели с provider=openrouter (см. sheets-qa.config.ts) используют этот ключ.
# Нужен, только если в конфиге выбрана модель OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Модель OpenRouter для расшифровки голосовых Telegram (нужен OPENROUTER_API_KEY)
TRANSCRIPTION_MODEL=google/gemini-3.1-flash-lite

# --- Аудит сделок ---
DEAL_SYNC_INTERVAL_MINUTES=60
DEAL_SYNC_DEFAULT_WINDOW_MINUTES=60
CRM_DRIVER=mock
TELEGRAM_BOT_TOKEN=

# --- VocalAI: синхронизация звонков (SSO Синергии -> обмен на токен VocalAI) ---
# Логин/пароль сотрудника Синергии для входа в VocalAI; без них синхронизация не стартует
VOCAL_AI_SYNERGY_LOGIN=
VOCAL_AI_SYNERGY_PASSWORD=
VOCAL_AI_BASE_URL=https://app.vocal-ai.ru
# ID проектов VocalAI для синхронизации звонков через запятую; пустой список -> синхронизация не стартует
VOCAL_AI_PROJECT_IDS=
VOCAL_AI_SYNC_INTERVAL_MINUTES=5
VOCAL_AI_SYNC_ATTEMPTS=3
VOCAL_AI_SYNC_BACKOFF_MS=5000
# Дата (ISO, YYYY-MM-DD), с которой начинается первичный backfill нового проекта; без неё backfill идёт с эпохи
VOCAL_AI_BACKFILL_FROM_DATE=2026-11-16

# --- Telegram: привязка аккаунта и канал уведомлений ---
# Имя бота без @ (для ссылок t.me/<bot>). Без токена, имени или в режиме off бот считается не настроенным
TELEGRAM_BOT_USERNAME=
# Приём обновлений: webhook (прод), polling (локально), off
TELEGRAM_UPDATES_MODE=off
# Обязательны при webhook: публичный https-адрес POST /telegram/webhook и секрет от 32 символов [A-Za-z0-9_-]
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Срок жизни одноразовой ссылки привязки
TELEGRAM_LINK_TOKEN_TTL_SECONDS=600
# Бронь отправки уведомления; должна быть больше таймаута обработчика outbox (60000 мс)
TELEGRAM_DELIVERY_RESERVATION_MS=120000
# Адрес Bot API; локально без настоящего бота указывает на заглушку
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Публичный адрес портала (http/https, без хвостового /): ссылка «Открыть заявку» в Telegram-уведомлениях. Без него ссылки нет.
# Тот же origin, что добавлен в AUTH_ALLOWED_ORIGINS для портала
# PORTAL_PUBLIC_URL=https://portal.example.com

# --- Ретраи очередей (attempts, экспоненциальный backoff в мс) ---
DEAL_SYNC_ATTEMPTS=3
DEAL_SYNC_BACKOFF_MS=5000
AUDIT_ATTEMPTS=3
AUDIT_BACKOFF_MS=10000
NOTIFICATION_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=5000

# Путь к JSON-ключу service account для чтения Google Sheets (иначе Google ADC)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- LangSmith: трассировка запусков агента ---
# Если LANGSMITH_TRACING=true, LANGSMITH_API_KEY обязателен
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=audit-agent
LANGSMITH_ENDPOINT=

# --- Observability ---
# Loki: если пусто — логи пишутся только в stdout
LOKI_URL=http://localhost:3100
LOKI_LABELS_APP=audit-agent
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Auth (JWT) ---
# Обязательно, минимум 32 символа. Сгенерировать: openssl rand -base64 48. Заменить перед выкладкой
JWT_SECRET=test
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=14d
AUTH_REFRESH_GRACE_SECONDS=10
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
# Origin через запятую. Запись scheme://* разрешает любой хост этой схемы:
# chrome-extension://* принимает любое расширение Chrome (удобно, но проверка Origin
# тогда не отличает ваше расширение от чужого). Точный вариант: chrome-extension://<id>
# Origin портала Featurer добавить через запятую, например: chrome-extension://*,https://portal.example.com
AUTH_ALLOWED_ORIGINS=chrome-extension://*
# За reverse proxy: число прокси (1), true или список подсетей; иначе лимит по IP общий для всех
# TRUST_PROXY=1
# JSON для npm run seed:users: [{"login":"ivan"},{"login":"petr","password":"Temp-pass-1"}]; password необязателен
# Путь к JSON-файлу начальной загрузки {departments, users} (пример: db/seeds/users.example.json); вместе с AUTH_SEED_USERS не задавать
AUTH_SEED_FILE=
AUTH_SEED_USERS=

# --- Tasks ---
# Каталог для вложений задач (локальный диск; в контейнере смонтировать том)
TASKS_STORAGE_DIR=./storage/tasks
TASKS_MAX_FILE_SIZE_MB=20
TASKS_MAX_FILES_PER_TASK=10

# --- Хранилище файлов (S3, локально MinIO из docker compose) ---
# В compose бэкенд ходит на http://minio:9000; ключи совпадают с MINIO_ROOT_USER/PASSWORD.
# Без ключей используется minioadmin; при NODE_ENV=production ключи обязательны
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Бакет создаётся бэкендом при старте
S3_BUCKET=files
S3_FORCE_PATH_STYLE=true

# --- Файлы пользователей ---
FILES_MAX_RECORDING_MB=1024
FILES_MAX_DOCUMENT_MB=50
FILES_DOCUMENT_RETENTION_DAYS=30
FILES_RECORDING_RETENTION_DAYS=1
# Максимум удержания записи на время расшифровки
FILES_MAX_HOLD_DAYS=7
# Ежедневная очистка просроченных файлов (Europe/Moscow)
FILES_PURGE_CRON=0 3 * * *
# Секрет коротких ссылок скачивания, минимум 32 символа: openssl rand -base64 48
FILES_DOWNLOAD_TOKEN_SECRET=
FILES_DOWNLOAD_LINK_TTL_SEC=300

# --- Расшифровка записей встреч: целый файл одним запросом в OpenRouter STT (OPENROUTER_API_KEY) ---
MEETING_TRANSCRIPTION_MODEL=elevenlabs/scribe-v2
# Пусто: язык определяет модель (например, ru)
MEETING_TRANSCRIPTION_LANGUAGE=
# Расшифровка голоса по HTTP: запросов на пользователя в минуту
VOICE_TRANSCRIPTION_MAX_PER_MINUTE=20
# Максимум длительности записи (75 мин)
MEETING_TRANSCRIPTION_MAX_DURATION_SEC=4500
# Таймаут HTTP-запроса на всю запись, не больше 290000
MEETING_TRANSCRIPTION_STT_TIMEOUT_MS=240000
# Предел размера сжатого файла, байты: в base64 с JSON укладывается в лимит OpenRouter 25 МБ
MEETING_TRANSCRIPTION_MAX_AUDIO_BYTES=18000000
MEETING_TRANSCRIPTION_ATTEMPTS=3
# Параллельные записи в воркере
MEETING_TRANSCRIPTION_CONCURRENCY=2
# Дедлайн одной попытки (2 ч): по истечении расшифровка получает failed с причиной timeout
MEETING_TRANSCRIPTION_JOB_TIMEOUT_MS=7200000

# --- Извлечение задач из встреч и сообщения системы в чате ---
# Пусто: модель по умолчанию
MEETING_TASKS_EXTRACTION_MODEL=
# Расшифровка длиннее порога (токены) режется на окна указанной длины, минуты
MEETING_TASKS_WINDOW_TOKENS=60000
MEETING_TASKS_WINDOW_MINUTES=30
# Повтор сообщения системы, пока в чате идёт запуск, и предельный срок доставки
CHAT_SYSTEM_MESSAGE_RETRY_MS=5000
CHAT_SYSTEM_MESSAGE_DEADLINE_MS=600000

# --- Outbox и уведомления ---
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
NOTIFICATIONS_WS_PING_INTERVAL_MS=20000

# --- Внешние порты docker compose (на сервере с другими стеками 3000/3001/5432/6379/9090 заняты) ---
# POSTGRES_PORT=5433
# REDIS_PORT_PUBLISHED=6380
# PROMETHEUS_PORT=9091
# LOKI_PORT=3101
# GRAFANA_PORT=3002
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
