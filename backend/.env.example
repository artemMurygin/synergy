# --- App ---
NODE_ENV=development
PORT=1234
# Внешний порт при запуске через docker compose
APP_PORT=1234
LOG_LEVEL=info

# --- PostgreSQL: основная БД (Slonik) ---
POSTGRES_URL=postgresql://audit:audit@localhost:5432/audit_agent

# --- MSSQL: внешняя БД (Prisma) ---
MSSQL_URL=sqlserver://localhost:1433;database=master;user=sa;password=Audit_Agent1;trustServerCertificate=true

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- LLM ---
OPENAI_API_KEY=
# Необязательно: прокси-совместимый endpoint (например, omniroute), напр. http://localhost:20128/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1

# Прототип sheets-qa: модели с provider=openrouter (см. sheets-qa.config.ts) используют этот ключ.
# Нужен, только если в конфиге выбрана модель OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# --- Аудит сделок ---
DEAL_SYNC_INTERVAL_MINUTES=60
DEAL_SYNC_DEFAULT_WINDOW_MINUTES=60
CRM_DRIVER=mock
TELEGRAM_BOT_TOKEN=

# --- Ретраи очередей (attempts, экспоненциальный backoff в мс) ---
DEAL_SYNC_ATTEMPTS=3
DEAL_SYNC_BACKOFF_MS=5000
AUDIT_ATTEMPTS=3
AUDIT_BACKOFF_MS=10000
NOTIFICATION_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=5000

# Путь к JSON-ключу service account для чтения Google Sheets (иначе Google ADC)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- LangSmith: трассировка запусков агента ---
# Если LANGSMITH_TRACING=true, LANGSMITH_API_KEY обязателен
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=audit-agent
LANGSMITH_ENDPOINT=

# --- Observability ---
# Loki: если пусто — логи пишутся только в stdout
LOKI_URL=http://localhost:3100
LOKI_LABELS_APP=audit-agent
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Auth (JWT) ---
# Обязательно, минимум 32 символа. Сгенерировать: openssl rand -base64 48. Заменить перед выкладкой
JWT_SECRET=test
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=14d
AUTH_REFRESH_GRACE_SECONDS=10
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
# Origin через запятую. Запись scheme://* разрешает любой хост этой схемы:
# chrome-extension://* принимает любое расширение Chrome (удобно, но проверка Origin
# тогда не отличает ваше расширение от чужого). Точный вариант: chrome-extension://<id>
AUTH_ALLOWED_ORIGINS=chrome-extension://*
# За reverse proxy: число прокси (1), true или список подсетей; иначе лимит по IP общий для всех
# TRUST_PROXY=1
# JSON для npm run seed:users: [{"login":"ivan"},{"login":"petr","password":"Temp-pass-1"}]; password необязателен
AUTH_SEED_USERS=

# --- Tasks ---
# Каталог для вложений задач (локальный диск; в контейнере смонтировать том)
TASKS_STORAGE_DIR=./storage/tasks
TASKS_MAX_FILE_SIZE_MB=20
TASKS_MAX_FILES_PER_TASK=10

# --- Внешние порты docker compose (на сервере с другими стеками 3000/3001/5432/6379/9090 заняты) ---
# POSTGRES_PORT=5433
# REDIS_PORT_PUBLISHED=6380
# PROMETHEUS_PORT=9091
# LOKI_PORT=3101
# GRAFANA_PORT=3002
