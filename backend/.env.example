# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL: основная БД (Slonik) ---
POSTGRES_URL=postgresql://audit:audit@localhost:5432/audit_agent

# --- MSSQL: внешняя БД (Prisma) ---
MSSQL_URL=sqlserver://localhost:1433;database=master;user=sa;password=Audit_Agent1;trustServerCertificate=true

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- LLM ---
OPENAI_API_KEY=
# Необязательно: прокси-совместимый endpoint (например, omniroute), напр. http://localhost:20128/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1

# Прототип sheets-qa: модели с provider=openrouter (см. sheets-qa.config.ts) используют этот ключ.
# Нужен, только если в конфиге выбрана модель OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# --- Аудит сделок ---
DEAL_SYNC_INTERVAL_MINUTES=60
DEAL_SYNC_DEFAULT_WINDOW_MINUTES=60
CRM_DRIVER=mock
TELEGRAM_BOT_TOKEN=

# --- Ретраи очередей (attempts, экспоненциальный backoff в мс) ---
DEAL_SYNC_ATTEMPTS=3
DEAL_SYNC_BACKOFF_MS=5000
AUDIT_ATTEMPTS=3
AUDIT_BACKOFF_MS=10000
NOTIFICATION_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=5000

# --- Programs ETL (агентная синхронизация каталога программ) ---
# Путь к JSON-ключу service account для чтения Google Sheets (иначе Google ADC)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Scheduler выключен по умолчанию; при включении OPENAI_API_KEY обязателен
PROGRAMS_ETL_SCHEDULER_ENABLED=false
PROGRAMS_ETL_SCAN_CRON=0 * * * *
PROGRAMS_ETL_CONCURRENCY=1
PROGRAMS_ETL_ATTEMPTS=3
PROGRAMS_ETL_BACKOFF_MS=5000
PROGRAMS_ETL_OPENAI_MODEL=gpt-4o
PROGRAMS_ETL_AGENT_MAX_STEPS=40
PROGRAMS_ETL_AGENT_TIMEOUT_MS=600000
# Меньше ~20k токенов на ответ: иначе deepagents уносит ответ в файл, и агент не видит данные
PROGRAMS_ETL_SHEETS_MAX_CELLS=400

# --- LangSmith: трассировка запусков агента ---
# Если LANGSMITH_TRACING=true, LANGSMITH_API_KEY обязателен
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=audit-agent
LANGSMITH_ENDPOINT=

# --- Observability ---
# Loki: если пусто — логи пишутся только в stdout
LOKI_URL=http://localhost:3100
LOKI_LABELS_APP=audit-agent
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
