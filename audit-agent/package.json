{
  "name": "audit-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Audit agent: NestJS + BullMQ + LangGraph",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "dev:docker": "docker compose up --build --watch",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint": "eslint src prisma.config.ts",
    "lint:fix": "eslint --fix src prisma.config.ts",
    "format": "prettier --write \"src/**/*.ts\" prisma.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" prisma.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/openai": "^1.7.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-mssql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prometheus-io/client": "^0.16.1",
    "@scalar/nestjs-api-reference": "^1.2.31",
    "@willsoto/nestjs-prometheus": "^7.0.0",
    "bullmq": "^6.4.0",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slonik": "^49.11.0",
    "zod": "^4.6.7"
  }
}
